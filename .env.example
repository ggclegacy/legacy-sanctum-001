# Safe public project identifier.
NEXT_PUBLIC_SUPABASE_URL=https://gwrvybrexplkmjbsrxst.supabase.co

# Add the real publishable key locally. Do not commit it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public application URL used for passwordless auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only privileged key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only secret used to sign temporary invitation sessions.
INVITE_SESSION_SECRET=

# Set to true only for an internal, non-production visual preview.
ENABLE_INTERNAL_PREVIEW=false

# Reserved for approved Atlas narration assets.
ATLAS_AUDIO_BUCKET=atlas-invitations

# Server-only ElevenLabs credentials for temporary Atlas voice testing.
# Never prefix either value with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
ATLAS_VOICE_ID=

# Server-only destination for the member-confirmation SMS deep link.
# Use E.164 format, for example: +15551234567
FOUNDER_PHONE_NUMBER=
